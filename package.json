{
  "name": "cortico-world-mota",
  "version": "0.1.35",
  "type": "module",
  "description": "让桌宠自主游玩 HTML5 魔塔。理论上支持所有基于 HTML5 样板制作的经典魔塔及其衍生变体，支持原生地形探索、全塔物资统筹与陪伴式互动。",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "mota",
    "magic-tower",
    "h5mota",
    "game"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "tags": [
      "game",
      "high-cost"
    ],
    "describe": "describe.json",
    "webUiClient": "src/webui/client.js",
    "displayName": "h5魔塔（50层）",
    "icon": "assets/icon.png"
  },
  "files": [
    "src",
    "README.md",
    "README_zh.md",
    "CHANGELOG.md",
    "describe.json",
    "assets"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "cortico": "^0.2.12",
    "typescript": "^5.7.2"
  },
  "author": "userchang",
  "repository": {
    "type": "git",
    "url": "https://github.com/userchang/cortico-world-mota.git"
  },
  "homepage": "https://github.com/userchang/cortico-world-mota#readme",
  "bugs": {
    "url": "https://github.com/userchang/cortico-world-mota/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "node --check src/webui/client.js && node --check src/game-adapter.js && tsc --noEmit",
    "pack": "npm pack"
  }
}
